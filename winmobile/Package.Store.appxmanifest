<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store build, D2Engine, under the Partner Center identity. Built
     with StoreBuild=true (see README); Package.appxmanifest is the GitHub build. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="AstrohackerML.D2Engine"
    Publisher="CN=731ECEE4-03DC-405A-B788-3758C0ED0488"
    Version="1.0.1.0" />

  <mp:PhoneIdentity PhoneProductId="90858d94-5545-4342-bc93-c1c08cbf444d" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>D2Engine</DisplayName>
    <PublisherDisplayName>AstrohackerML</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Descent2.App">
      <uap:VisualElements
        DisplayName="D2Engine"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="D2Engine: a Descent II engine port that plays your own copy of the game"
        BackgroundColor="#000000">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000"/>
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape"/>
          <uap:Rotation Preference="landscapeFlipped"/>
        </uap:InitialRotationPreference>
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
